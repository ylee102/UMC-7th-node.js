
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique(map: "email") @db.VarChar(255)
  name          String   @db.VarChar(100)
  gender        String   @db.VarChar(15)
  birth         DateTime @db.Date
  address       String   @db.VarChar(255)
  detailAddress String?  @map("detail_address") @db.VarChar(255)
  phoneNumber   String   @map("phone_number") @db.VarChar(15)

  userFavorCategories UserFavorCategory[]
  reviews   Review[]

  //다대다 관계 
  missions UserMission[]

  @@map("user")
}

model Mission {
  id           Int         @id @default(autoincrement())
  title        String      @db.VarChar(100)
  description  String      @db.Text
  reward       Int
  deadline     DateTime    @db.DateTime(6)
  created_at   DateTime    @db.DateTime(6)
  updated_at   DateTime    @db.DateTime(6)

  // Many-to-many relation with User
  users UserMission[]

  @@map("mission")
}

// UserMission join table model (for m:n relation between User and Mission)
model UserMission {
  id         Int      @id @default(autoincrement())
  user_id    Int
  mission_id Int
  status     String   @db.VarChar(15)
  created_at DateTime @db.DateTime(6)
  updated_at DateTime @db.DateTime(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [mission_id], references: [id], onDelete: Cascade)

  @@unique([user_id, mission_id]) // Ensures a unique combination of user and mission
  @@map("user_mission")           // Maps to the user_mission table in the database
}

model FoodCategory {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  userFavorCategories UserFavorCategory[]

  @@map("food_category")
}

model UserFavorCategory {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int          @map("user_id")
  foodCategory   FoodCategory @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId Int          @map("food_category_id")

  @@index([foodCategoryId], map: "f_category_id")
  @@index([userId], map: "user_id")
  @@map("user_favor_category")
}

model Store {
  id         Int      @id @default(autoincrement())
  region_id  Int
  name       String   @db.VarChar(50)
  address    String   @db.VarChar(50)
  score      Float
  created_at DateTime @db.DateTime(6)
  updated_at DateTime @db.DateTime(6)

  region     Region   @relation(fields: [region_id], references: [id])
  reviews    Review[] // Many-to-many relationship with User through Review

  @@map("store")
}

// Region model
model Region {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(20)
  created_at DateTime @db.DateTime(6)
  updated_at DateTime @db.DateTime(6)

  stores     Store[]  // One-to-many relationship with Store
}

model Review {
  id        Int    @id @default(autoincrement())
  content   String @db.Text
  score     Float
  storeId   Int
  userId    Int

  // Foreign Key Relationships
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}




